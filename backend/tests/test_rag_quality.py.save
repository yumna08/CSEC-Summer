                    mock_clie    rag = RAGService(api_key="fake_key", model="gemini-2.5-flash")
    mock_client = MagicMock()
    rag._client = mock_client

    grounded_chunk = {
        "text": "The Office of the Dean of Student Services provides Cafeteria Services and Dormitory Services.",
        "metadata": {"source_title": "Dean of Student Services", "source_url": "https://www.astu.edu.et/ss"},
        "distance": 0.20,
    }
    ungrounded_chunk = {
        "text": "Research Symposium Abstract Template formatting guidelines for MS Word.",
        "metadata": {"source_title": "Symposium Template", "source_url": "https://www.astu.edu.et/symp"},
        "distance": 0.25,
    }

    with patch("app.services.rag.embedding_service.embed_query", return_value=[0.1, 0.2]):
        with patch("app.services.rag.vector_store.similarity_search", return_value=[grounded_chunk, ungrounded_chunk]):
            mock_response = MagicMock()
            # Model completely omits the SOURCES_USED tag
            mock_response.text = "The Dean of Student Services manages Cafeteria and Dormitory accommodations for students."
            mock_client.models.generate_content.return_value = mock_response

            answer, sources = rag.answer_question("Where can I find dormitory services?")

            # Only the grounded chunk is cited, ungrounded chunk is excluded
            assert len(sources) == 1
            assert sources[0].title == "Dean of Student Services"


def test_regression_general_study_tips_no_spurious_sources():
    """Regression test: General study advice questions must NOT return spurious sources."""
    rag = RAGService(api_key="fake_key", model="gemini-2.5-flash")
    mock_client = MagicMock()
    rag._client = mock_client

    with patch("app.services.rag.embedding_service.embed_query", return_value=[0.1, 0.2]):
        with patch("app.services.rag.vector_store.similarity_search", return_value=[]):
            mock_response = MagicMock()
            mock_response.text = (
                "Here are general exam preparation tips: Start early, plan a schedule, "
                "practice with past problems, and maintain a healthy sleep cycle.\n\n"
                "SOURCES_USED: NONE"
            )
            mock_client.models.generate_content.return_value = mock_response

            answer, sources = rag.answer_question("How can I prepare for exams?")

            assert "general exam preparation tips" in answer
            assert "SOURCES_USED" not in answer  # Tag cleanly stripped
            assert sources == []  # No research symposium or calendar citations!


def test_regression_astu_student_services_retrieval():
    """Regression test: Student services questions retrieve and cite official source."""
    rag = RAGService(api_key="fake_key", model="gemini-2.5-flash")
    mock_client = MagicMock()
    rag._client = mock_client

    mock_chunk = {
        "text": "The Dean of Student Services provides Cafeteria Services, Dormitory Services, and Health Services.",
        "metadata": {
            "source_title": "Dean of Student Services",
            "source_url": "https://www.astu.edu.et/offices/administration-development/dean-of-student-services",
            "document_name": "dean-of-student-services.html",
            "academic_year": None,
            "publication_date": None,
        },
        "distance": 0.2378,
        "relevance_score": 0.7622,
    }

    with patch("app.services.rag.embedding_service.embed_query", return_value=[0.1, 0.2]):
        with patch("app.services.rag.vector_store.similarity_search", return_value=[mock_chunk]):
            mock_response = MagicMock()
            mock_response.text = (
                "The Office of the Dean of Student Services at ASTU provides Cafeteria, "
                "Dormitory, and Health Services.\n\n"
                "SOURCES_USED: [1]"
            )
            mock_client.models.generate_content.return_value = mock_response

            answer, sources = rag.answer_question("What services does the Dean of Student Services provide?")

            assert "Cafeteria, Dormitory, and Health Services" in answer
            assert "SOURCES_USED" not in answer
            assert len(sources) == 1
            assert sources[0].title == "Dean of Student Services"
            assert sources[0].url == "https://www.astu.edu.et/offices/administration-development/dean-of-student-services"


