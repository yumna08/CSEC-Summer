from unittest.mock import MagicMock, patch
import pytest
from app.core.config import RAG_MAX_COSINE_DISTANCE, RAG_RELEVANCE_THRESHOLD, RAG_SCORE_MARGIN
from app.schemas.chat import SourceCitation
from app.services.rag import (
    RAGService,
    parse_source_indices,
    verify_citation_grounding,
)
from app.services.vector_store import VectorStoreService


@pytest.fixture
def test_vector_store(tmp_path):
    store = VectorStoreService(persist_dir=tmp_path / "chroma_test_quality")
    # Add representative test chunks
    # Chunk 1: Dean of Student Services
    # unk 2: ASTU Active Calendars Portal
    # Chunk 3: Research Symposium Abstract Template (weak/irrelevant noise chunk)
    store.collection.add(
        ids=["chunk_student_services", "chunk_calendar", "chunk_symposium_noise"],
        documents=[
            "The Office of the Dean of Student Services provides Cafeteria Services, Dormitory Services, and Health Services.",
            "Active Calendars 2026/2027 First Semester: Grade submission begins October 15, Final Exams from January 11 to January 22.",
            "Abstract Template 5th International Research Symposium ASTU: Manuscripts must be submitted in MS Word format (.doc or .docx).",
        ],
        metadatas=[
            {"source_title": "Dean of Student Services", "source_url": "https://www.astu.edu.et/student-services", "doc_id": "doc_ss"},
            {"source_title": "ASTU Active Calendars Portal", "source_url": "https://portal.astu.edu.et/pages/active_calendars", "doc_id": "doc_cal"},
            {"source_title": "Abstract Template 5th International Research Symposium", "source_url": "https://www.astu.edu.et/symposium.pdf", "doc_id": "doc_symp"},
        ],
        # Controlled 3D embeddings to test exact distance geometry
        embeddings=[
            [1.0, 0.0, 0.0],  # Student services
            [0.0, 1.0, 0.0],  # Calendar
            [0.5, 0.5, 0.7],  # Symposium noise
        ],
    )
    return store


# -----------------------------------------------------------------------------
# Part A: Threshold Interpretation & Metric Standardization Tests
# -----------------------------------------------------------------------------

def test_standardized_max_cosine_distance_config():
    """Verify standardization on RAG_MAX_COSINE_DISTANCE (0.38) and deprecation compatibility."""
    assert RAG_MAX_COSINE_DISTANCE == 0.38
    assert RAG_RELEVANCE_THRESHOLD == 0.38


def test_threshold_dual_interpretation():
    """Verify that both distance threshold (0.38) and similarity threshold (0.62) compute max_dist = 0.38."""
    # When specified as distance <= 0.5
    d1 = 0.38 if 0.38 <= 0.5 else (1.0 - 0.38)
    assert d1 == 0.38

    # When specified as similarity > 0.5
    d2 = (1.0 - 0.62) if 0.62 > 0.5 else 0.62
    assert pytest.approx(d2, 0.001) == 0.38


def test_similarity_search_margin_filtering(test_vector_store):
    """
    Verify that weakly related trailing chunks are excluded by margin filtering,
    preventing irrelevant chunks from filling top-K.
    """
    # Query very close to Student Services ([0.98, 0.02, 0.0])
    results = test_vector_store.similarity_search(
        query_embedding=[0.98, 0.02, 0.0],
        top_k=3,
        max_distance=0.38,
        score_margin=0.10,
    )
    # Only the Student Services chunk qualifies
    assert len(results) == 1
    assert results[0]["metadata"]["source_title"] == "Dean of Student Services"
    assert results[0]["distance"] < 0.01


def test_similarity_search_rejects_all_when_top_chunk_exceeds_threshold(test_vector_store):
    """
    Verify that when the top-ranked chunk has distance > relevance_threshold,
    NO chunks are admitted.
    """
    results = test_vector_store.similarity_search(
        query_embedding=[-0.6, -0.6, -0.5],
        top_k=3,
        max_distance=0.38,
        score_margin=0.10,
    )
    assert len(results) == 0


# -----------------------------------------------------------------------------
# Part B: Independent Citation Grounding & Source Index Verification Tests
# -----------------------------------------------------------------------------

def test_parse_source_indices_validation():
    """Verify robust parsing of model-generated citation indices: bounds, malformed, duplicates, missing."""
    # Malformed tokens, negative, 0, out of bounds, and duplicates
    res = parse_source_indices("[invalid, -1, 0, 999, 1, 1, 2, word, 3.5]", max_valid_index=2)
    assert res == [1, 2]

    # Out of range indices
    assert parse_source_indices("3, 4, 5", max_valid_index=2) == []

    # Duplicates deduplicated preserving order
    assert parse_source_indices("2, 1, 2, 1", max_valid_index=2) == [2, 1]

    # Missing / None / Empty / NONE / [] tags
    assert parse_source_indices("", max_valid_index=3) == []
    assert parse_source_indices("NONE", max_valid_index=3) == []
    assert parse_source_indices("EMPTY", max_valid_index=3) == []
    assert parse_source_indices("[]", max_valid_index=3) == []
    assert parse_source_indices("N/A", max_valid_index=3) == []


def test_independent_citation_grounding_verification():
    """Verify that cited text actually substantiates factual claims about ASTU."""
    # Chunk with student services details
    chunk_text = "The Office of the Dean of Student Services provides Cafeteria Services, Dormitory Services, and Health Services."
    valid_reply = "The Dean of Student Services at ASTU oversees Cafeteria, Dormitory, and Health Services for students."

    # Substantiated citation -> True
    assert verify_citation_grounding(chunk_text, valid_reply, "Dean of Student Services") is True

    # Hallucinated citation: Model outputs generic tips or unrelated content, but cites chunk
    hallucinated_reply = "To prepare for exams, create a timetable, get enough sleep, and practice previous questions."
    assert verify_citation_grounding(chunk_text, hallucinated_reply, "Dean of Student Services") is False

    # Calendar dates verification
    cal_chunk = "Final Exams are scheduled from January 11 to January 22, 2027 on the active academic calendar."
    cal_reply = "According to official records, Final Exams run from January 11 to January 22, 2027."
    assert verify_citation_grounding(cal_chunk, cal_reply, "ASTU Active Calendars Portal") is True

    # Edge cases
    assert verify_citation_grounding("", "Some reply") is False
    assert verify_citation_grounding(chunk_text, "") is False


