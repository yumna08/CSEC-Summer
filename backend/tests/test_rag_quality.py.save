# -----------------------------------------------------------------------------
# Part C: Safe No-Match Verification Tests
# -----------------------------------------------------------------------------

def test_safe_no_match_unknown_registration_procedure():
    """Verify safe no-match: Unknown department registration procedures do not invent steps or dates."""
    rag = RAGService(api_key="fake_key", model="gemini-2.5-flash")
    mock_client = MagicMock()
    rag._client = mock_client

    with patch("app.services.rag.embedding_service.embed_query", return_value=[0.1, 0.2]):
        with patch("app.services.rag.vector_store.similarity_search", return_value=[]):
            mock_response = MagicMock()
            mock_response.text = (
                "I do not have verified information in the indexed ASTU knowledge base regarding "
                "the specific 4th-year Software Engineering add/drop registration procedures. "
                "Please check the official ASTU student portal at https://portal.astu.edu.et or "
                "consult your department registrar.\n\n"
                "SOURCES_USED: NONE"
            )
            mock_client.models.generate_content.return_value = mock_response

            answer, sources = rag.answer_question(
                "What are the specific department add/drop registration steps for 4th year Software Engineering students at ASTU?"
            )

            assert "do not have verified information" in answer
            assert "portal.astu.edu.et" in answer
            assert sources == []


