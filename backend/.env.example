# Copy this file to backend/.env and replace values as needed.

# Storage paths
DATA_DIR=data
CHROMA_PERSIST_DIR=data/chroma_db
REGISTRY_FILE=data/source_registry.json

# Gemini API
GEMINI_API_KEY=replace-with-a-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-flash-latest,gemini-flash-lite-latest
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_MAX_RETRIES=2

# RAG and chunking
CHUNK_SIZE=800
CHUNK_OVERLAP=150
RAG_TOP_K=4
RAG_MAX_COSINE_DISTANCE=0.38
RAG_RELEVANCE_THRESHOLD=0.38
RAG_SCORE_MARGIN=0.10

# Crawler and uploads
APPROVED_DOMAINS=astu.edu.et,portal.astu.edu.et
MAX_CRAWL_PAGES=15
CRAWL_TIMEOUT_SECONDS=10
MAX_UPLOAD_SIZE_BYTES=10485760

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_STORAGE_URI=memory://
CHAT_RATE_LIMIT=60/minute
ADMIN_RATE_LIMIT=10/minute

# Administrative API access
APP_ENV=development
ADMIN_API_KEY=replace-with-a-long-random-admin-key
REQUIRE_ADMIN_AUTH=true

# Database
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/campusguide
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_PRE_PING=true

# Frontend may use this when running from the repository root.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
